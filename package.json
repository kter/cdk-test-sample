{
  "name": "cdk-test-sample",
  "version": "0.1.0",
  "bin": {
    "cdk-test-sample": "bin/cdk-test-sample.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
