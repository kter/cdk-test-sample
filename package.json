  "devDependencies": {
    "@eslint/js": "^9.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "20.12.7",
    "aws-cdk": "2.148.1",
    "cdk-nag": "^2.28.118",
    "eslint": "^9.3.0",
    "husky": "^9.0.11",
    "jest": "^30.5.2",
    "lint-staged": "^17.6.1",
    "prettier": "3.2.5",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "~5.4.5"
  },
  "dependencies": {
    "@cdklabs/cdk-validator-cfnguard": "^0.0.58",
    "aws-cdk-lib": "2.277.0",
    "constructs": "^10.0.0",
    "source-map-support": "^0.5.21"
  }
